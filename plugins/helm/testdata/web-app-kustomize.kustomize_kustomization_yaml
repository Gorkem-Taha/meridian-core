apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - helm-rendered.yaml
images:
  - name: nginx
    newName: registry.example.com/mirror/nginx
labels:
  - includeSelectors: false
    pairs:
      environment: production
namePrefix: prod-
patches:
  - patch: |
      - op: add
        path: /spec/template/spec/containers/0/resources
        value:
          limits:
            memory: 256Mi
    target:
      kind: Deployment
      name: web
replicas:
  - count: 4
    name: web
