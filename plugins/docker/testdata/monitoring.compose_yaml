name: monitoring
services:
  exporter:
    image: prom/node-exporter:v1.9.1
    command:
      - --path.rootfs=/host
    pid: host
    restart: unless-stopped
    volumes:
      - /:/host:ro,rslave
  prometheus:
    image: prom/prometheus:v3.5.0
    depends_on:
      exporter:
        condition: service_started
    configs:
      - source: prometheus_config
        target: /etc/prometheus/prometheus.yml
    healthcheck:
      interval: 10s
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://localhost:9090/-/healthy
    ports:
      - 9090:9090
    restart: unless-stopped
    volumes:
      - metrics:/prometheus
  grafana:
    image: grafana/grafana:12.1.0
    depends_on:
      prometheus:
        condition: service_healthy
    ports:
      - 3000:3000
    restart: unless-stopped
    volumes:
      - dashboards:/var/lib/grafana
volumes:
  metrics: {}
  dashboards: {}
configs:
  prometheus_config:
    content: |
      scrape_configs:
        - job_name: node
          static_configs:
            - targets: ["exporter:9100"]
