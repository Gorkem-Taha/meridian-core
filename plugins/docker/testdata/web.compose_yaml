name: web
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_DB: app
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
    networks:
      - backend
    secrets:
      - db_password
    volumes:
      - db_data:/var/lib/postgresql/data
  app:
    image: ghcr.io/example/app:1.4.2
    depends_on:
      db:
        condition: service_started
    environment:
      DATABASE_HOST: db
    networks:
      - backend
  proxy:
    image: nginx:1.27
    depends_on:
      app:
        condition: service_started
    configs:
      - source: site
        target: /etc/nginx/conf.d/default.conf
    labels:
      meridian.dev/restart-on-site: 185ed24724f46635
    networks:
      - backend
    ports:
      - "80"
networks:
  backend: {}
volumes:
  db_data: {}
configs:
  site:
    content: |
      server {
        listen 80;
        location / { proxy_pass http://app:8000; }
      }
secrets:
  db_password:
    environment: DB_PASSWORD
