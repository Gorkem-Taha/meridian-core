# Compiled by Meridian from the document shop. Do not edit.
name: shop-prod
services:
  db:
    environment:
      POSTGRES_DB: shop
      POSTGRES_PASSWORD_FILE: /run/secrets/db_password
    healthcheck:
      interval: 5s
      retries: 10
      test:
        - CMD-SHELL
        - pg_isready -U postgres -d shop
    image: postgres:17
    networks:
      - backend
    secrets:
      - db_password
    volumes:
      - db_data:/var/lib/postgresql/data
  api:
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgres://postgres@db:5432/shop
    image: ghcr.io/acme/shop-api:${SHOP_VERSION:-latest}
    networks:
      - backend
      - default
    restart: unless-stopped
    secrets:
      - db_password
  web:
    depends_on:
      api:
        condition: service_started
        restart: true
    environment:
      API_UPSTREAM: http://api:8000
    image: nginx:1.27
    ports:
      - "80"
networks:
  backend:
    internal: true
volumes:
  db_data: {}
secrets:
  db_password:
    environment: SHOP_DB_PASSWORD
