{
  "output": {
    "config": {
      "value": "${terraform_data.config.output}"
    }
  },
  "resource": {
    "terraform_data": {
      "config": {
        "input": "v1"
      },
      "service": {
        "input": "running",
        "lifecycle": {
          "create_before_destroy": true,
          "replace_triggered_by": [
            "terraform_data.config"
          ]
        }
      }
    }
  }
}
