{
  "data": {
    "aws_ami": {
      "ubuntu": {
        "filter": [
          {
            "name": "name",
            "values": [
              "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"
            ]
          }
        ],
        "most_recent": true,
        "owners": [
          "099720109477"
        ]
      }
    }
  },
  "locals": {
    "name_prefix": "web-${var.region}"
  },
  "output": {
    "web_url": {
      "value": "http://${aws_eip.web_ip.public_dns}/"
    },
    "web_vm_ip": {
      "value": "${aws_eip.web_ip.public_ip}"
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}"
    }
  },
  "resource": {
    "aws_eip": {
      "web_ip": {
        "instance": "${aws_instance.web_vm.id}"
      }
    },
    "aws_instance": {
      "web_vm": {
        "ami": "${data.aws_ami.ubuntu.id}",
        "instance_type": "t3.small",
        "tags": {
          "Name": "${local.name_prefix}-${data.aws_ami.ubuntu.architecture}"
        },
        "vpc_security_group_ids": [
          "${aws_security_group.web_sg.id}"
        ]
      }
    },
    "aws_security_group": {
      "web_sg": {
        "ingress": [
          {
            "cidr_blocks": [
              "0.0.0.0/0"
            ],
            "from_port": 80,
            "protocol": "tcp",
            "to_port": 80
          }
        ],
        "name": "${local.name_prefix}"
      }
    },
    "terraform_data": {
      "dns_ready": {
        "depends_on": [
          "aws_eip.web_ip"
        ],
        "input": "ready"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    }
  },
  "variable": {
    "region": {
      "default": "us-east-1",
      "type": "string"
    }
  }
}
