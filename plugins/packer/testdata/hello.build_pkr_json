{
  "build": {
    "name": "hello",
    "post-processors": [
      {
        "post-processor": [
          {
            "shell-local": {
              "inline": [
                "echo \"3 post-processed\" >> steps.txt"
              ]
            }
          },
          {
            "shell-local": {
              "inline": [
                "echo \"4 and again\" >> steps.txt"
              ]
            }
          }
        ]
      },
      {
        "post-processor": [
          {
            "manifest": {
              "output": "meridian-manifest.json",
              "strip_path": true
            }
          }
        ]
      }
    ],
    "provisioner": [
      {
        "shell-local": {
          "inline": [
            "echo \"1 ${local.message}\" > steps.txt"
          ]
        }
      },
      {
        "shell-local": {
          "inline": [
            "echo \"2 ${source.type}.${source.name}\" >> steps.txt"
          ]
        }
      }
    ],
    "sources": [
      "source.null.box"
    ]
  },
  "locals": {
    "message": "${var.greeting} from ${upper(\"packer\")}"
  },
  "source": {
    "null": {
      "box": {
        "communicator": "none"
      }
    }
  },
  "variable": {
    "greeting": {
      "default": "hello",
      "type": "string"
    }
  }
}
