{
  "build": {
    "error-cleanup-provisioner": {
      "shell-local": {
        "inline": [
          "echo \"the build of ${build.name} failed\""
        ]
      }
    },
    "name": "app-container",
    "post-processors": [
      {
        "post-processor": [
          {
            "docker-tag": {
              "repository": "registry.example.com/team/app",
              "tags": [
                "${var.version}",
                "latest"
              ]
            }
          },
          {
            "docker-push": {
              "login": true,
              "login_password": "${var.registry_password}",
              "login_server": "registry.example.com",
              "login_username": "ci"
            }
          }
        ]
      },
      {
        "post-processor": [
          {
            "checksum": {
              "checksum_types": [
                "sha256"
              ],
              "output": "app.{{.ChecksumType}}"
            }
          }
        ]
      },
      {
        "post-processor": [
          {
            "manifest": {
              "output": "meridian-manifest.json",
              "strip_path": true
            }
          }
        ]
      }
    ],
    "provisioner": [
      {
        "shell": {
          "inline": [
            "apt-get update",
            "apt-get install -y --no-install-recommends ca-certificates",
            "rm -rf /var/lib/apt/lists/*"
          ]
        }
      },
      {
        "file": {
          "destination": "/usr/local/bin/app",
          "source": "dist/app"
        }
      }
    ],
    "sources": [
      "source.docker.app"
    ]
  },
  "packer": {
    "required_plugins": {
      "docker": {
        "source": "github.com/hashicorp/docker",
        "version": ">= 1.0.8"
      }
    }
  },
  "source": {
    "docker": {
      "app": {
        "changes": [
          "EXPOSE 8080",
          "ENTRYPOINT [\"/usr/local/bin/app\"]"
        ],
        "commit": true,
        "image": "debian:bookworm-slim"
      }
    }
  },
  "variable": {
    "registry_password": {
      "default": "",
      "sensitive": true,
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "type": "string"
    }
  }
}
