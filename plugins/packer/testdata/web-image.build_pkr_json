{
  "build": {
    "name": "web-image",
    "post-processors": [
      {
        "post-processor": [
          {
            "manifest": {
              "output": "meridian-manifest.json",
              "strip_path": true
            }
          }
        ]
      }
    ],
    "provisioner": [
      {
        "shell": {
          "inline": [
            "cloud-init status --wait"
          ]
        }
      },
      {
        "shell": {
          "environment_vars": [
            "DEBIAN_FRONTEND=noninteractive"
          ],
          "inline": [
            "sudo apt-get update",
            "sudo apt-get install -y nginx",
            "echo \"built by $${USER} on $(date)\" | sudo tee /etc/motd"
          ]
        }
      },
      {
        "file": {
          "content": "server { listen 80 default_server; root /var/www/html; }\n",
          "destination": "/tmp/default"
        }
      },
      {
        "shell": {
          "inline": [
            "sudo mv /tmp/default /etc/nginx/sites-available/default",
            "sudo systemctl enable nginx"
          ]
        }
      }
    ],
    "sources": [
      "source.amazon-ebs.ubuntu"
    ]
  },
  "data": {
    "amazon-ami": {
      "base": {
        "filters": {
          "name": "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*",
          "virtualization-type": "hvm"
        },
        "most_recent": true,
        "owners": [
          "099720109477"
        ],
        "region": "${var.region}"
      }
    }
  },
  "locals": {
    "stamp": "${formatdate(\"YYYYMMDDhhmmss\", timestamp())}"
  },
  "packer": {
    "required_plugins": {
      "amazon": {
        "source": "github.com/hashicorp/amazon",
        "version": ">= 1.3.0"
      }
    }
  },
  "source": {
    "amazon-ebs": {
      "ubuntu": {
        "ami_name": "web-${local.stamp}",
        "instance_type": "t3.small",
        "region": "${var.region}",
        "source_ami": "${data.amazon-ami.base.id}",
        "ssh_username": "ubuntu",
        "tags": {
          "BaseImage": "${data.amazon-ami.base.name}",
          "Name": "web"
        }
      }
    }
  },
  "variable": {
    "region": {
      "default": "us-east-1",
      "type": "string"
    }
  }
}
